# Copy to .env and fill in. .env is read automatically by llm.py (python-dotenv).
# Never commit .env to git.

# Hugging Face access token (https://huggingface.co/settings/tokens, "Read" scope).
# Required for gated models such as meta-llama/Llama-3.2-3B-Instruct.
HF_TOKEN=

# Optional overrides
# CHATBOT_CONFIG=config.yaml     # use another config file
# CHATBOT_HOST=0.0.0.0           # listen on all interfaces (containers)
# HF_HOME=/data/hf-cache         # where models are downloaded
# HF_HUB_OFFLINE=1               # never contact huggingface.co (after the first download)
